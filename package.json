{
	"name": "kaktus-connector",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "tsx src/application-cli/kaktus.ts",
		"build": "tsx tooling/build.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check .",
		"check": "npm run typecheck && npm run lint && npm run dc && npm run duplicates && npm run build",
		"dc": "depcruise --config .dependency-cruiser.cjs src tooling",
		"duplicates": "jscpd --config jscpd.json"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.2",
		"effect": "4.0.2",
		"zod": "4.6.5"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "24.19.0",
		"esbuild": "0.28.1",
		"tsx": "4.23.15",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"dependency-cruiser": "18.4.0",
		"jscpd": "5.3.3"
	},
	"allowScripts": {
		"esbuild": true
	}
}
